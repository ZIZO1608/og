# =============================================================================
#  OG SYSTEM — environment
# -----------------------------------------------------------------------------
#  COPY THIS FILE TO  .env  (same folder) AND FILL IN THE BLANKS.
#
#      cd server
#      cp .env.example .env
#
#  .env is already in server/.gitignore. This repository is PUBLIC, so a
#  committed key is not a mistake you can quietly fix later — git keeps
#  history, and the only real repair is rotating every key involved.
#
#  Nothing here is required to run the shop today. With no .env at all the
#  server starts exactly as it always has, on the local SQLite file.
# =============================================================================


# ---- Supabase ---------------------------------------------------------------
#  Dashboard → your project → Project Settings → API
#  (newer dashboards call the same page "API Keys")

#  Project URL. Looks like https://abcdefghijklmnop.supabase.co
#  Settings → API → Project URL
SUPABASE_URL=

#  The PUBLIC key. Safe to expose; it is restricted by row level security.
#  Labelled `anon` `public`, or `publishable` on newer dashboards.
#  Not currently used by the server — the browser never talks to Supabase —
#  but fill it in so it is to hand if that ever changes.
SUPABASE_ANON_KEY=

#  The SECRET key. Labelled `service_role` `secret`, or `secret` / sb_secret_…
#
#  THIS ONE BYPASSES ROW LEVEL SECURITY ENTIRELY. It is a master key for the
#  whole database. It belongs on a server and nowhere else — never in the
#  browser, never in a screenshot, never pasted into a chat window. If it is
#  ever exposed, rotate it in the dashboard rather than hoping.
SUPABASE_SERVICE_ROLE_KEY=

#  OPTIONAL — direct Postgres connection string.
#  Settings → Database → Connection string → URI
#  Only needed if we move the live database onto Supabase rather than using
#  the REST API. It contains your database password, so the warning above
#  applies to it just as much. Leave blank for now.
SUPABASE_DB_URL=

#  How often the server pushes the shop to Supabase, in minutes.
#  The server does this itself while it runs — nothing to start or remember.
#  Default 10. Set 0 to turn automatic mirroring off and push by hand with
#  `npm run supabase:sync`. Ignored entirely when no Supabase key is set.
OG_SYNC_MINUTES=10


# ---- The existing server settings -------------------------------------------
#  All optional. These already worked before this file existed; they are
#  listed so there is one place that shows every knob.

#  Port the server listens on.
OG_PORT=8090

#  Where the SQLite database lives. Default: server/data/og.db
OG_DB=

#  Folder served as the app. Default: the folder above server/
OG_STATIC=

#  Set to 1 when the server sits behind HTTPS, so session cookies get the
#  Secure flag. Leave 0 on a local machine or logins will not stick.
OG_SECURE=0

#  Comma-separated origins allowed to make state-changing calls (anything that
#  is not a GET). This is the CSRF defence.
#
#  IMPORTANT: leaving this blank does not mean "allow the shop" — it means
#  ALLOW EVERYTHING. Verified: with it blank, a POST carrying
#  `Origin: http://evil.example.com` is let straight through to the handler;
#  with it set, the same request is refused with 403 before it touches
#  anything. Blank is survivable on a shop network nobody else is on. It is
#  the wrong setting the moment the till is reachable from outside.
#
#  Must match EXACTLY — scheme, host and port. http and https are different
#  origins, and so are a hostname and the IP behind it, so list every address
#  actually used to open the app:
#
#    Shop wifi + Tailscale from home:
#      OG_ORIGINS=http://localhost:8090,http://10.10.254.174:8090,http://og-shop:8090
#
#    Behind a real HTTPS domain:
#      OG_ORIGINS=https://og.example.com
OG_ORIGINS=

#  Set to 1 only when behind a reverse proxy you control, so X-Forwarded-For
#  is trusted for login throttling. Wrong here means the throttle can be
#  defeated by forging a header.
OG_TRUST_PROXY=0
