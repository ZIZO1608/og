# =============================================================================
#  OG SYSTEM — environment
# -----------------------------------------------------------------------------
#  COPY THIS FILE TO  .env  (same folder) AND FILL IN THE BLANKS.
#
#      cd server
#      cp .env.example .env
#
#  .env is already in server/.gitignore. This repository is PUBLIC, so a
#  committed key is not a mistake you can quietly fix later — git keeps
#  history, and the only real repair is rotating every key involved.
#
#  Nothing here is required to run the shop today. With no .env at all the
#  server starts exactly as it always has, on the local SQLite file.
# =============================================================================


# ---- Supabase ---------------------------------------------------------------
#  Dashboard → your project → Project Settings → API
#  (newer dashboards call the same page "API Keys")

#  Project URL. Looks like https://abcdefghijklmnop.supabase.co
#  Settings → API → Project URL
SUPABASE_URL=

#  The PUBLIC key. Safe to expose; it is restricted by row level security.
#  Labelled `anon` `public`, or `publishable` on newer dashboards.
#  Not currently used by the server — the browser never talks to Supabase —
#  but fill it in so it is to hand if that ever changes.
SUPABASE_ANON_KEY=

#  The SECRET key. Labelled `service_role` `secret`, or `secret` / sb_secret_…
#
#  THIS ONE BYPASSES ROW LEVEL SECURITY ENTIRELY. It is a master key for the
#  whole database. It belongs on a server and nowhere else — never in the
#  browser, never in a screenshot, never pasted into a chat window. If it is
#  ever exposed, rotate it in the dashboard rather than hoping.
SUPABASE_SERVICE_ROLE_KEY=

#  OPTIONAL — direct Postgres connection string.
#  Settings → Database → Connection string → URI
#  Only needed if we move the live database onto Supabase rather than using
#  the REST API. It contains your database password, so the warning above
#  applies to it just as much. Leave blank for now.
SUPABASE_DB_URL=

#  How often the server does a FULL pass over the mirror, in minutes.
#  Changes go up by themselves a couple of seconds after they happen; the
#  full pass is the safety net that rewrites the settings tables whole and
#  walks every bookmark. Nothing to start or remember.
#  Default 60. Set 0 to turn automatic mirroring off entirely and push by
#  hand with `npm run supabase:sync`. Ignored when no Supabase key is set.
#
#  ONE PROJECT, ONE DATABASE. A second machine with this same file pointed at
#  the same project is not a backup of the shop — it is a second writer that
#  deletes the shop's rows and overwrites its bookmarks (that happened
#  twice). A development or test copy sets this to 0, or gets a Supabase
#  project of its own.
OG_SYNC_MINUTES=60

#  The first database to sync claims the project (server/lib/lineage.js) and
#  every other database is refused. Set this to 1 for ONE run to say "this
#  machine is the shop from now on" — then run npm run supabase:reconcile,
#  and unset it. Never leave it on: a machine that always takes over is a
#  machine that always wins the fight described above.
OG_SYNC_TAKEOVER=

#  Passphrase that seals staff credentials before they reach Supabase.
#  With it set, each mirrored user carries an AES-256-GCM box holding their
#  scrypt hash — which Supabase cannot read — so a dead shop machine can be
#  restored WITH its accounts (npm run supabase:restore). Leave it blank and
#  nothing about the mirror changes: no credential material is sent at all.
#
#  LOSING THIS MEANS LOSING THOSE BOXES. There is no recovery path, by
#  design. Keep it wherever you keep the Supabase secret key — and NOT in
#  this repository, which is public.
OG_VAULT_KEY=


# ---- HTTPS ------------------------------------------------------------------
#  Other devices need HTTPS before their browser will allow notifications, the
#  camera barcode scanner, or installing the app. Make the certificate once:
#
#      cd server && npm run cert
#
#  The server then serves HTTPS on this port and sends browsers there from the
#  plain HTTP one. Each device shows one "not a known authority" warning the
#  first time — press Advanced, then continue.
OG_HTTPS_PORT=8443
#  Set to 0 to stay on plain HTTP even with a certificate present.
#OG_HTTPS=0


# ---- Telegram ---------------------------------------------------------------
#  Two bots, one per company: the shop's staff get their notifications from
#  one, Yalla Wear gets theirs from the other, and neither ever sees the
#  other's token. Make each one in Telegram:
#
#      1. Open a chat with @BotFather and send  /newbot
#      2. Give it a name (e.g. "OG System") and a username ending in "bot"
#      3. Copy the token it hands back — it looks like 123456789:AAF...
#
#  Paste the tokens below and restart the server. Then, in the app:
#  Settings → Telegram → Connect shows a six-letter code; open the bot (or add
#  it to a staff group), send the code, and that chat is linked. Yalla Wear
#  does the same from their own portal with their own bot.
#
#  A token is a password for the bot. Leave both blank and the app keeps
#  every notification inside itself, exactly as before.
OG_TELEGRAM_TOKEN_OG=
OG_TELEGRAM_TOKEN_YALLA=


# ---- The existing server settings -------------------------------------------
#  All optional. These already worked before this file existed; they are
#  listed so there is one place that shows every knob.

#  Port the server listens on.
OG_PORT=8090

#  Where the SQLite database lives. Default: server/data/og.db
OG_DB=

#  Folder served as the app. Default: the folder above server/
OG_STATIC=

#  Set to 1 when the server sits behind HTTPS, so session cookies get the
#  Secure flag. Leave 0 on a local machine or logins will not stick.
OG_SECURE=0

#  Comma-separated origins allowed to make state-changing calls (anything that
#  is not a GET). This is the CSRF defence.
#
#  IMPORTANT: leaving this blank does not mean "allow the shop" — it means
#  ALLOW EVERYTHING. Verified: with it blank, a POST carrying
#  `Origin: http://evil.example.com` is let straight through to the handler;
#  with it set, the same request is refused with 403 before it touches
#  anything. Blank is survivable on a shop network nobody else is on. It is
#  the wrong setting the moment the till is reachable from outside.
#
#  Must match EXACTLY — scheme, host and port. http and https are different
#  origins, and so are a hostname and the IP behind it, so list every address
#  actually used to open the app:
#
#    Shop wifi + Tailscale from home:
#      OG_ORIGINS=http://localhost:8090,http://10.10.254.174:8090,http://og-shop:8090
#
#    Behind a real HTTPS domain:
#      OG_ORIGINS=https://og.example.com
OG_ORIGINS=

#  Set to 1 only when behind a reverse proxy you control, so X-Forwarded-For
#  is trusted for login throttling. Wrong here means the throttle can be
#  defeated by forging a header.
OG_TRUST_PROXY=0
