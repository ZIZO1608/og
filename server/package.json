{
  "name": "og-system-server",
  "version": "1.0.0",
  "private": true,
  "description": "OG System backend — SQLite, sessions, sync. Zero runtime dependencies by design.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node index.js",
    "preflight": "node scripts/preflight.js",
    "hardware": "node scripts/hardware.js",
    "hardware:install": "node scripts/hardware.js --install",
    "dev": "node --watch index.js",
    "createuser": "node scripts/createuser.js",
    "backup": "node scripts/backup.js",
    "supabase:check": "node scripts/supabase-check.js",
    "supabase:drift": "node scripts/mirror-drift.js",
    "supabase:test-write": "node scripts/supabase-test-write.js",
    "supabase:sync": "node scripts/supabase-sync.js",
    "supabase:restore": "node scripts/supabase-restore.js",
    "supabase:reconcile": "node scripts/supabase-reconcile.js"
  },
  "dependencies": {},
  "devDependencies": {}
