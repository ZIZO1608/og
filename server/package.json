{
  "name": "og-system-server",
  "version": "1.0.0",
  "private": true,
  "description": "OG System backend — SQLite, sessions, sync. Zero runtime dependencies by design.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test \"test/*.test.js\"",
    "preflight": "node scripts/preflight.js",
    "cert": "node scripts/make-cert.js",
    "cert:trust": "node scripts/trust-cert.js",
    "cert:untrust": "node scripts/trust-cert.js --remove",
    "always-on": "node scripts/always-on.js",
    "hardware": "node scripts/hardware.js",
    "hardware:install": "node scripts/hardware.js --install",
    "test-print": "node scripts/test-print.js",
    "test-print:dry": "node scripts/test-print.js --dry",
    "dev": "node --watch index.js",
    "createuser": "node scripts/createuser.js",
    "botfather": "node scripts/botfather.js",
    "web:key": "node scripts/web-key.js",
    "backup": "node scripts/backup.js",
    "warehouse:one-room": "node scripts/warehouse-one-room.js",
    "supabase:check": "node scripts/supabase-check.js",
    "supabase:drift": "node scripts/mirror-drift.js",
    "supabase:sync": "node scripts/supabase-sync.js",
    "supabase:restore": "node scripts/supabase-restore.js",
    "supabase:reconcile": "node scripts/supabase-reconcile.js",
    "users:rebuild": "node scripts/users-rebuild.js",
    "users:mirror": "node scripts/users-mirror.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
