{
  "name": "og-system",
  "private": true,
  "description": "Forwards to server/package.json, so npm commands work from the repo root as well as from server/.",
  "scripts": {
    "start": "npm --prefix server run start --",
    "dev": "npm --prefix server run dev --",
    "test": "npm --prefix server run test --",
    "preflight": "npm --prefix server run preflight --",
    "cert": "npm --prefix server run cert --",
    "cert:trust": "npm --prefix server run cert:trust --",
    "cert:untrust": "npm --prefix server run cert:untrust --",
    "hardware": "npm --prefix server run hardware --",
    "hardware:install": "npm --prefix server run hardware:install --",
    "test-print": "npm --prefix server run test-print --",
    "test-print:dry": "npm --prefix server run test-print:dry --",
    "createuser": "npm --prefix server run createuser --",
    "botfather": "npm --prefix server run botfather --",
    "backup": "npm --prefix server run backup --",
    "warehouse:one-room": "npm --prefix server run warehouse:one-room --",
    "supabase:check": "npm --prefix server run supabase:check --",
    "supabase:drift": "npm --prefix server run supabase:drift --",
    "supabase:sync": "npm --prefix server run supabase:sync --",
    "supabase:restore": "npm --prefix server run supabase:restore --",
    "supabase:reconcile": "npm --prefix server run supabase:reconcile --"
  }
}
